# Claude API key (server only). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=
# Model and fast mode for the 15-second card. Defaults: claude-opus-5-5, fast on.
QONAQ_MODEL=claude-opus-5-5
QONAQ_FAST=1
# Database: local file by default; Turso in production (libsql://... + token)
DATABASE_URL=file:./data/qonaq.db
DATABASE_AUTH_TOKEN=
# Public origin used in WhatsApp links and QR codes (set to the deployed URL)
PUBLIC_BASE_URL=
# Set to 0 to start with an empty catalog
QONAQ_SEED=1
